# Public site URL (used for sitemap, canonical and Open Graph URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# PostgreSQL connection string (server-side only). For Supabase use the
# Project Settings > Database > Connection string (pooler). Never prefix with NEXT_PUBLIC_.
DATABASE_URL=postgres://user:password@host:5432/postgres
# Set to "false" for a local non-SSL Postgres
DATABASE_SSL=true

# Admin area (/admin). Without both of these, /admin stays locked.
ADMIN_PASSWORD=change-me
# 32+ random characters, e.g.  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_SESSION_SECRET=

# Marks this as a non-production environment. Tests and destructive scripts refuse to run unless this is
# "development" or "test", so they can never touch production by accident.
APP_ENV=development
